{
  "name": "kuzgram",
  "version": "1.1.0",
  "description": "Закрытый семейный чат: PWA с пуш-уведомлениями на iPhone. Express, SQLite, фронт без сборщика",
  "keywords": [
    "pwa",
    "web-push",
    "push-notifications",
    "ios",
    "service-worker",
    "express",
    "sqlite",
    "better-sqlite3",
    "chat",
    "messenger",
    "self-hosted",
    "vanilla-js",
    "no-build"
  ],
  "license": "MIT",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "invite": "node bin/invite.js",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  }
}
